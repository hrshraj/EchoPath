\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \rev  {Relative depth as used by EchoPath} (sign.mp4, 2.0~s). (a)~Detected box and zone. (b,~c)~Per-frame MiDaS Small and Depth Anything V2 Small depth (1 = nearest point of this frame) with the frame's 75th (solid, ``close'') and 50th (dashed, ``medium'') percentile contours. The wet floor sign is close because its inner-box median lies above the 75th percentile (0.98 for MiDaS); \rev  {the values carry no metric scale.}}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:reldepth}{{4}{8}{\rev {Relative depth as used by EchoPath} (sign.mp4, 2.0~s). (a)~Detected box and zone. (b,~c)~Per-frame MiDaS Small and Depth Anything V2 Small depth (1 = nearest point of this frame) with the frame's 75th (solid, ``close'') and 50th (dashed, ``medium'') percentile contours. The wet floor sign is close because its inner-box median lies above the 75th percentile (0.98 for MiDaS); \rev {the values carry no metric scale.}}{figure.4}{}}
