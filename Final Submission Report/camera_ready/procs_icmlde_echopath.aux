\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \rev  {Dataset versions and results on each run's own validation split.} ``Head'' is the number of output classes, ``eval.'' the number with validation labels; leakage is the share of validation images with a near-duplicate (Hamming distance $\leq 4$) in training. v2's data are reconstructed from an archived copy made before table and monitor were added (21,601 / 2,352 / 1,211 images) plus the table and monitor images identified in v3: validation is exact, training and test sizes are derived from the logged batches per epoch, and leakage is an upper bound. Absolute changes: v1 to v2 $+$0.068 P, $+$0.134 R, $+$0.107 mAP@50, $+$0.108 mAP@50-95; v2 to v3 $-$0.014, $-$0.040, $-$0.039 ($-$4.3\% relative) and $-$0.042.}}{4}{table.2}\protected@file@percent }
\newlabel{tab:datasets}{{2}{4}{\rev {Dataset versions and results on each run's own validation split.} ``Head'' is the number of output classes, ``eval.'' the number with validation labels; leakage is the share of validation images with a near-duplicate (Hamming distance $\leq 4$) in training. v2's data are reconstructed from an archived copy made before table and monitor were added (21,601 / 2,352 / 1,211 images) plus the table and monitor images identified in v3: validation is exact, training and test sizes are derived from the logged batches per epoch, and leakage is an upper bound. Absolute changes: v1 to v2 $+$0.068 P, $+$0.134 R, $+$0.107 mAP@50, $+$0.108 mAP@50-95; v2 to v3 $-$0.014, $-$0.040, $-$0.039 ($-$4.3\% relative) and $-$0.042}{table.2}{}}
